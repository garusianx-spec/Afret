# ---- Afrat realtime service ----

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,https://afrat.app

# Socket.io mount path — must match NEXT_PUBLIC_SOCKET_PATH in the web app.
SOCKET_PATH=/realtime

# ---- Authentication ----
# HS256 signing secret for access tokens. REQUIRED in production — the
# process refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Redis is optional in development. Set it in production: without the adapter,
# two app instances cannot deliver each other's messages.
REDIS_URL=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@afrat.app

# Object storage for attachments (presigned uploads).
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# ---- SMS (optional) ----
# The OTP module is written but no provider is wired. See docs/authentication.md
# for the Kavenegar example.
# KAVENEGAR_KEY=
