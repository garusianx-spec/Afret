# ---- Afrat web (.env.local) ----

# Base URL of the realtime/REST service (apps/realtime)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Socket.io namespace used by the chat module
NEXT_PUBLIC_SOCKET_PATH=/realtime

# VAPID public key for Web Push subscriptions (see docs/pwa-strategy.md)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Set to "1" to register the service worker in `next dev` as well.
NEXT_PUBLIC_SW_IN_DEV=0
